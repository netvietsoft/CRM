// Registry nguồn đơn hàng (Order.source giữ là chuỗi `code`, bảng này để quản lý tên/màu/bật-tắt)
model OrderSource {
  id        String   @id @default(uuid())
  code      String   @unique // mã dùng trong Order.source: PANCAKE, VIETTEL, SHOPEE...
  name      String // tên hiển thị: Viettel, Website, Shopee...
  type      String   @default("manual") // 'manual' (admin chọn) | 'integration' (tự động)
  color     String? // màu badge (hex), tùy chọn
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_sources")
}

// Đơn/khách tải về từ ViettelPost (1 dòng / mã vận đơn, upsert mỗi webhook). Lưu TẤT CẢ field VTP.
model ViettelCustomer {
  id                   String    @id @default(uuid())
  trackingCode         String    @unique @map("tracking_code")
  orderReference       String?   @map("order_reference")
  status               Int?
  statusName           String?   @map("status_name")
  statusDate           DateTime? @map("status_date")
  sendDate             DateTime? @map("send_date") // ngày gửi (ORDER_SYSTEMDATE) — dùng cho thống kê tiền hàng
  codPayStatus         String?   @map("cod_pay_status") // VTP: KHONG_CO_COD | CHUA_NHAN_COD | CHO_NHAN_COD | DA_NHAN_COD
  codPayStatusName     String?   @map("cod_pay_status_name")
  codPaySyncedAt       DateTime? @map("cod_pay_synced_at")
  receiverFullname     String?   @map("receiver_fullname")
  receiverPhone        String?   @map("receiver_phone")
  receiverAddress      String?   @map("receiver_address") @db.Text
  receiverProvinceId   Int?      @map("receiver_province_id")
  receiverDistrictId   Int?      @map("receiver_district_id")
  receiverWardId       Int?      @map("receiver_ward_id")
  productName          String?   @map("product_name") @db.Text
  detailPayload        Json?     @map("detail_payload")
  detailEnrichedAt     DateTime? @map("detail_enriched_at")
  cod                  Float     @default(0)
  codOrigin            Float?    @map("cod_origin")
  moneyTotal           Float?    @map("money_total")
  moneyTotalFee        Float?    @map("money_total_fee")
  moneyTotalVat        Float?    @map("money_total_vat")
  moneyFeeCod          Float?    @map("money_fee_cod")
  voucherValue         Float?    @map("voucher_value")
  productWeight        Int?      @map("product_weight")
  orderService         String?   @map("order_service")
  orderServiceAdd      String?   @map("order_service_add")
  orderPayment         Int?      @map("order_payment")
  expectedDelivery     String?   @map("expected_delivery") @db.Text
  expectedDeliveryDate String?   @map("expected_delivery_date")
  note                 String?   @db.Text
  orderNote            String?   @map("order_note") @db.Text
  locationCurrently    String?   @map("location_currently") @db.Text
  employeeName         String?   @map("employee_name")
  employeePhone        String?   @map("employee_phone")
  isReturning          Boolean   @default(false) @map("is_returning")
  reasonCode           String?   @map("reason_code")
  groupAddressId       String?   @map("group_address_id")
  detail               Json?
  pod                  Json?
  courierHistory       Json?     @map("courier_history")
  rawPayload           Json?     @map("raw_payload")
  storeId              String?   @map("store_id")
  vtpAccountId         String?   @map("vtp_account_id") // tài khoản VTP sở hữu đơn (null = tài khoản chính từ env)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([sendDate])
  @@index([vtpAccountId])
  @@map("viettel_customers")
}

// Tài khoản ViettelPost PHỤ — chỉ để ĐỒNG BỘ VỀ (import lịch sử đơn + đối soát COD).
// Tạo đơn mới vẫn dùng tài khoản chính trong env. Mật khẩu mã hoá AES-256-GCM (token-vault pack()).
model VtpAccount {
  id              String    @id @default(uuid())
  label           String // tên hiển thị (vd "Shop 2")
  username        String    @unique
  passwordEnc     String    @map("password_enc") @db.Text
  webToken        String?   @map("web_token") @db.Text // token WEB portal (import/COD) — hết hạn ~7 ngày, dán lại
  webTokenSavedAt DateTime? @map("web_token_saved_at")
  isActive        Boolean   @default(true) @map("is_active")
  lastImportAt    DateTime? @map("last_import_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("vtp_accounts")
}

model AdminNotification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("admin_notifications")
}

model OtpRecord {
  id        String   @id @default(uuid())
  phone     String
  otpCode   String   @map("otp_code")
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, isUsed, expiresAt])
  @@map("otp_records")
}

// ===== Quảng cáo (Ads) — kéo toàn bộ chiến dịch + chỉ số về CRM =====
// Chuẩn hoá theo nền tảng (v1: META). Mỗi bảng giữ thêm `raw Json` = payload gốc
// đầy đủ để AI phân tích sau, không bỏ sót field nào.

model AdAccount {
  id           String       @id @default(uuid())
  storeId      String?      @map("store_id") // coupling lỏng, không FK
  platform     String       @default("META")
  externalId   String       @map("external_id") // vd "act_123456"
  name         String?       @db.Text
  currency     String?
  timezoneName String?       @map("timezone_name")
  status       String?
  accountStatus Int?         @map("account_status")
  disableReason Int?         @map("disable_reason")
  balance      Float?
  amountSpent  Float?        @map("amount_spent")
  spendCap     Float?        @map("spend_cap")
  fundingSource String?      @map("funding_source")
  fundingDetails Json?       @map("funding_details") // funding_source_details: { display_string, type, coupon... } → cột "Cách thanh toán"
  businessExternalId String? @map("business_external_id")
  businessName String?       @map("business_name") @db.Text
  userCount    Int?          @map("user_count")
  adminCount   Int?          @map("admin_count")
  myRole       String?       @map("my_role")
  lastSyncedAt DateTime?     @map("last_synced_at")
  raw          Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  campaigns    AdCampaign[]
  adSets       AdSet[]
  ads          Ad[]
  insights     AdInsight[]

  @@unique([platform, externalId])
  @@map("ad_accounts")
}

model AdCampaign {
  id             String      @id @default(uuid())
  accountId      String      @map("account_id")
  platform       String      @default("META")
  externalId     String      @map("external_id")
  name           String?     @db.Text
  status         String?
  objective      String?
  dailyBudget    Float?      @map("daily_budget")
  lifetimeBudget Float?      @map("lifetime_budget")
  startTime      DateTime?   @map("start_time")
  stopTime       DateTime?   @map("stop_time")
  raw            Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  account        AdAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adSets         AdSet[]
  ads            Ad[]
  insights       AdInsight[]

  @@unique([platform, externalId])
  @@index([accountId])
  @@map("ad_campaigns")
}

model AdSet {
  id               String      @id @default(uuid())
  accountId        String      @map("account_id")
  campaignId       String?     @map("campaign_id")
  platform         String      @default("META")
  externalId       String      @map("external_id")
  name             String?     @db.Text
  status           String?
  dailyBudget      Float?      @map("daily_budget")
  lifetimeBudget   Float?      @map("lifetime_budget")
  optimizationGoal String?     @map("optimization_goal")
  billingEvent     String?     @map("billing_event")
  targeting        Json?
  startTime        DateTime?   @map("start_time")
  stopTime         DateTime?   @map("stop_time")
  raw              Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  account          AdAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaign         AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ads              Ad[]
  insights         AdInsight[]

  @@unique([platform, externalId])
  @@index([accountId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id          String      @id @default(uuid())
  accountId   String      @map("account_id")
  campaignId  String?     @map("campaign_id")
  adSetId     String?     @map("ad_set_id")
  platform    String      @default("META")
  externalId  String      @map("external_id")
  name        String?        @db.Text
  status      String?
  creative    Json?
  raw         Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  account     AdAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaign    AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adSet       AdSet?      @relation(fields: [adSetId], references: [id], onDelete: SetNull)
  insights    AdInsight[]

  @@unique([platform, externalId])
  @@index([accountId])
  @@index([campaignId])
  @@index([adSetId])
  @@map("ads")
}

model AdInsight {
  id               String      @id @default(uuid())
  platform         String      @default("META")
  level            String // 'account' | 'campaign' | 'adset' | 'ad'
  entityExternalId String      @map("entity_external_id")
  accountId        String      @map("account_id")
  campaignId       String?     @map("campaign_id")
  adSetId          String?     @map("ad_set_id")
  adId             String?     @map("ad_id")
  date             DateTime    @db.Date
  spend            Float?
  impressions      Int?
  reach            Int?
  clicks           Int?
  uniqueClicks     Int?        @map("unique_clicks")
  ctr              Float?
  cpc              Float?
  cpm              Float?
  frequency        Float?
  results          Int?
  costPerResult    Float?      @map("cost_per_result")
  actions          Json?
  actionValues     Json?       @map("action_values")
  raw              Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  account          AdAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaign         AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adSet            AdSet?      @relation(fields: [adSetId], references: [id], onDelete: SetNull)
  ad               Ad?         @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@unique([platform, level, entityExternalId, date])
  @@index([accountId, date])
  @@index([campaignId, date])
  @@map("ad_insights")
}

model AdBusiness {
  id                 String   @id @default(uuid())
  platform           String   @default("META")
  externalId         String   @map("external_id")
  name               String?  @db.Text
  verificationStatus String?  @map("verification_status")
  raw                Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([platform, externalId])
  @@map("ad_businesses")
}

model AdPage {
  id                 String   @id @default(uuid())
  storeId            String?  @map("store_id") // scope đa cửa hàng (coupling lỏng)
  platform           String   @default("META")
  externalId         String   @map("external_id")
  name               String?  @db.Text
  category           String?
  tasks              Json?    // quyền token có trên page: ADVERTISE/ANALYZE/CREATE_CONTENT/MESSAGING/MODERATE/MANAGE/VIEW_MONETIZATION_INSIGHTS
  fanCount           Int?     @map("fan_count")
  followersCount     Int?     @map("followers_count")
  link               String?  @db.Text
  verificationStatus String?  @map("verification_status")
  isPublished        Boolean? @map("is_published")
  businessExternalId String?  @map("business_external_id")
  lastSyncedAt       DateTime? @map("last_synced_at")
  raw                Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([platform, externalId])
  @@index([businessExternalId])
  @@map("ad_pages")
}

model AdProductMap {
  id                 String   @id @default(uuid())
  storeId            String?  @map("store_id")
  platform           String   @default("META")
  level              String // 'campaign' (v1); để sẵn 'adset' | 'ad'
  adEntityExternalId String   @map("ad_entity_external_id")
  productId          String   @map("product_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([platform, level, adEntityExternalId])
  @@index([productId])
  @@index([storeId])
  @@map("ad_product_maps")
}

// ===== Messenger inbox (chat với khách của Page) =====
model MsgPage {
  id            String            @id @default(uuid())
  storeId       String?           @map("store_id")
  platform      String            @default("META")
  externalId    String            @map("external_id")
  name          String?           @db.Text
  accessToken   String?           @map("access_token") @db.Text
  subscribed    Boolean           @default(false)
  lastSyncedAt  DateTime?         @map("last_synced_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  contacts      MsgContact[]
  conversations MsgConversation[]

  @@unique([platform, externalId])
  @@map("msg_pages")
}

model MsgContact {
  id            String            @id @default(uuid())
  pageId        String            @map("page_id")
  psid          String
  name          String?           @db.Text
  phone         String?           // SĐT khách tự cung cấp trong chat (trích từ nội dung tin)
  dob           DateTime?         // ngày sinh khách (set từ 3A); đồng bộ sang User.dob nếu khớp SĐT
  gender        Gender?           // giới tính khách (set từ 3A); đồng bộ sang User.gender nếu khớp SĐT duy nhất
  avatarUrl     String?           @map("avatar_url") @db.Text
  raw           Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  page          MsgPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversations MsgConversation[]

  @@unique([pageId, psid])
  @@map("msg_contacts")
}

model MsgConversation {
  id              String       @id @default(uuid())
  pageId          String       @map("page_id")
  contactId       String       @map("contact_id")
  lastMessageAt   DateTime?    @map("last_message_at")
  lastMessageText String?      @map("last_message_text") @db.Text
  lastMessageDir  String?      @map("last_message_dir")
  unreadCount     Int          @default(0) @map("unread_count")
  status          String       @default("OPEN")
  assignedUserId     String?   @map("assigned_user_id")
  assignedUserName   String?   @map("assigned_user_name")
  assignedUserAvatar String?   @map("assigned_user_avatar") @db.Text
  labels             Json?     // nhãn tự do (mảng chuỗi) cho hội thoại
  star               String?   // sao ưu tiên: yellow | green | red | null
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  page            MsgPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contact         MsgContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages        MsgMessage[]

  @@unique([pageId, contactId])
  @@index([pageId, lastMessageAt])
  @@map("msg_conversations")
}

model MsgMessage {
  id             String          @id @default(uuid())
  conversationId String          @map("conversation_id")
  mid            String?         @unique
  direction      String // IN | OUT
  text           String?         @db.Text
  attachments    Json?
  status         String?
  sentByUserId   String?         @map("sent_by_user_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  conversation   MsgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("msg_messages")
}

// Kết nối Facebook qua OAuth (long-lived user token, mã hoá). Bổ sung cho StoreIntegration(META_ADS) dán tay.
model FbConnection {
  id             String    @id @default(uuid())
  storeId        String?   @map("store_id")
  fbUserId       String    @map("fb_user_id")
  fbName         String?   @map("fb_name") @db.Text
  tokenEnc       String    @map("token_enc") @db.Text // user token mã hoá AES-256-GCM
  tokenIv        String    @map("token_iv")
  tokenTag       String    @map("token_tag")
  tokenExpiresAt DateTime? @map("token_expires_at")
  scopes         String?   @db.Text
  status         String    @default("ACTIVE") // ACTIVE | EXPIRED
  lastRefreshAt  DateTime? @map("last_refresh_at")
  raw            Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, fbUserId])
  @@map("fb_connections")
}

// Thư viện media dùng chung (ảnh/tệp/video đã upload lên R2) — cho picker chat CCM.
model MediaAsset {
  id         String   @id @default(uuid())
  url        String   @db.Text
  name       String?
  type       String   @default("image") // image | video | file
  folder     String?
  size       Int?
  uploaderId String?  @map("uploader_id")
  storeId    String?  @map("store_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([type])
  @@map("media_assets")
}

// ===== AI chốt đơn qua chat (CCM) =====
model AiAgentConfig {
  id            String   @id @default(uuid())
  pageId        String   @unique @map("page_id")
  enabled       Boolean  @default(false)
  mode          String   @default("SHADOW") // OFF | SHADOW | AUTO
  persona       String?  @db.Text
  productScope  Json?    @map("product_scope")
  dailyTokenCap Int?     @map("daily_token_cap")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("ai_agent_configs")
}

model AiConversationState {
  id             String    @id @default(uuid())
  conversationId String    @unique @map("conversation_id")
  status         String    @default("ACTIVE") // ACTIVE | HANDOFF | PAUSED
  slots          Json?
  lastAiAt       DateTime? @map("last_ai_at")
  tokensToday    Int       @default(0) @map("tokens_today")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  @@map("ai_conversation_states")
}

model AiSuggestion {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  replyText      String?  @db.Text @map("reply_text")
  toolCalls      Json?    @map("tool_calls")
  orderDraft     Json?    @map("order_draft")
  status         String   @default("PENDING") // PENDING | SENT | REJECTED
  createdAt      DateTime @default(now()) @map("created_at")
  @@index([conversationId, status])
  @@map("ai_suggestions")
}
