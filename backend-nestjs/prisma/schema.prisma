  comboProduct   Product  @relation("ComboProductItems", fields: [comboProductId], references: [id], onDelete: Cascade)
  childProduct   Product  @relation("ComboChildProduct", fields: [childProductId], references: [id], onDelete: Cascade)

  @@unique([comboProductId, childProductId])
  @@index([comboProductId])
  @@index([childProductId])
  @@map("product_combo_items")
}

model Wishlist {
