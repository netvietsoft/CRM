generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                       @id @default(uuid())
  role                          Role                         @default(CUSTOMER)
  name                          String?
  email                         String?                      @unique
  phone                         String?                      @unique
  password                      String?
  gender                        Gender?
  dob                           DateTime?
  address                       String?                      @db.Text
  addressStreet                 String?                      @map("address_street") @db.Text
  addressWard                   String?                      @map("address_ward")
  addressDistrict               String?                      @map("address_district")
  addressProvince               String?                      @map("address_province")
  avatarUrl                     String?
  interests                     Json?
  onboardingComplete            Boolean                      @default(false) @map("onboarding_complete")
  isActive                      Boolean                      @default(true) @map("is_active")
  zaloUserId                    String?                      @unique @map("zalo_user_id")
  fbUserId                      String?                      @unique @map("fb_user_id")
  totalSpent                    Float                        @default(0)
  rank                          Rank                         @default(MEMBER)
  points                        Int                          @default(0)
  spinTurns                     Int                          @default(0) @map("spin_turns")
  commissionBalance             Float                        @default(0) @map("commission_balance")
  referralCode                  String                       @unique @map("referral_code")
  referrerId                    String?                      @map("referrer_id")
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  googleId                      String?                      @unique @map("google_id")
  commissionsEarned             CommissionLedger[]           @relation("CommissionEarner")
  notifications                 Notification[]
  contactIdentities             CustomerContactIdentity[]
  messageAudiences              MessageAudience[]
  messageCampaignsCreated       MessageCampaign[]            @relation("MessageCampaignCreator")
  messageLogsCreated            MessageLog[]                 @relation("MessageLogCreator")
  messageLogsReceived           MessageLog[]                 @relation("MessageLogRecipient")
  messageOptOuts                MessageOptOut[]
  messageSchedulesCreated       MessageSchedule[]            @relation("MessageScheduleCreator")
  messageTemplatesCreated       MessageTemplate[]            @relation("MessageTemplateCreator")
  messageAutomationRulesCreated MessageAutomationRule[]      @relation("MessageAutomationRuleCreator")
  messageAutomationExecutions   MessageAutomationExecution[]
  oauthAccounts                 OAuthAccount[]
  orders                        Order[]
  ancestorEntries               ReferralClosure[]            @relation("ClosureAncestor")
  descendantEntries             ReferralClosure[]            @relation("ClosureDescendant")
  refreshTokens                 RefreshToken[]
  spinHistories                 SpinHistory[]
  userVouchers                  UserVoucher[]
  wishlists                     Wishlist[]
  reviews                       Review[]
  cart                          Cart?
  store                         Store?
  staffStoreId                  String?                      @map("staff_store_id")
  staffStore                    Store?                       @relation("StoreStaff", fields: [staffStoreId], references: [id], onDelete: SetNull)
  staffPermissions              Json?                        @map("staff_permissions")
  ordersAsSeller                Order[]                      @relation("OrderSeller")
  ordersAsCare                  Order[]                      @relation("OrderCare")
  referrer                      User?                        @relation("ReferralNetwork", fields: [referrerId], references: [id])
  referees                      User[]                       @relation("ReferralNetwork")

  @@index([referrerId])
  @@index([rank])
  @@map("users")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  provider       String
  providerUserId String   @map("provider_user_id")
  profile        Json?
  userId         String   @map("user_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "rt_user_fk")

  @@index([userId])
  @@map("refresh_tokens")
}

model ReferralClosure {
  id           String @id @default(uuid())
  ancestorId   String @map("ancestor_id")
  descendantId String @map("descendant_id")
  depth        Int
  ancestor     User   @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant   User   @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@unique([ancestorId, descendantId])
  @@index([ancestorId, depth])
  @@index([descendantId])
  @@map("referral_closures")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  parentId    String?    @map("parent_id")
  externalId  String?    @map("external_id")
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("categorytoproduct")
  storeId     String?    @map("store_id")
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([externalId])
  @@index([storeId])
  @@map("categories")
}

model Store {
  id                          String                       @id @default(uuid())
  name                        String
  slug                        String                       @unique
  logoUrl                     String?                      @map("logo_url") @db.LongText
  description                 String?                      @db.Text
  isActive                    Boolean                      @default(false) @map("is_active")
  isBanned                    Boolean                      @default(false) @map("is_banned")
  bannedReason                String?                      @map("banned_reason") @db.Text
  ownerId                     String                       @unique @map("owner_id")
  addressStreet               String?                      @map("address_street")
  addressWard                 String?                      @map("address_ward")
  addressDistrict             String?                      @map("address_district")
  addressProvince             String?                      @map("address_province")
  phone                       String?
  email                       String?
  allowCOD                    Boolean                      @default(true) @map("allow_cod")
  bankName                    String?                      @map("bank_name")
  bankAccountNo               String?                      @map("bank_account_no")
  bankOwnerName               String?                      @map("bank_owner_name")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  owner                       User                         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff                       User[]                       @relation("StoreStaff")
  products                    Product[]
  vouchers                    Voucher[]
  orders                      Order[]
  integrations                StoreIntegration[]
  categories                  Category[]
  messageAudiences            MessageAudience[]
  messageAutomationRules      MessageAutomationRule[]
  messageAutomationExecutions MessageAutomationExecution[]
  messageCampaigns            MessageCampaign[]
  messageLogs                 MessageLog[]
  messageProviderConfigs      MessageProviderConfig[]
  messageSchedules            MessageSchedule[]
  messageTemplates            MessageTemplate[]

  @@map("stores")
}

model StoreIntegration {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  platform    String
  apiKey      String?  @map("api_key") @db.Text
  apiSecret   String?  @map("api_secret") @db.Text
  shopId      String?  @map("shop_id")
  accessToken String?  @map("access_token") @db.Text
  isActive    Boolean  @default(false) @map("is_active")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, platform])
  @@map("store_integrations")
}

model Product {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  sku            String?
  externalId     String?          @map("external_id")
  imageUrl       String?          @map("image_url") @db.Text
  description    String?          @db.Text
  isComboSet     Boolean          @default(false) @map("is_combo_set")
  originalPrice  Float            @map("original_price")
  salePrice      Float?           @map("sale_price")
  stockQuantity  Int              @default(0) @map("stock_quantity")
  soldCount      Int              @default(0) @map("sold_count")
  weight         Int              @default(500)
  flashSaleEnd   DateTime?        @map("flash_sale_end")
  isGiftItem     Boolean          @default(false) @map("is_gift_item")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]
  cartItems      CartItem[]
  promoGifts     PromotionRule[]  @relation("GiftProduct")
  spinPrizeGifts SpinPrize[]      @relation("SpinGiftProduct")
  categories     Category[]       @relation("categorytoproduct")
  wishlists      Wishlist[]
  variants       ProductVariant[]
  reviews        Review[]
  storeId        String?          @map("store_id")
  store          Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([sku])
  @@index([externalId])
  @@map("products")
}

model Order {
  id                          String                       @id @default(uuid())
  userId                      String?                      @map("user_id")
  orderCode                   String                       @unique @map("order_code")
  source                      String?
  shippingName                String?                      @map("shipping_name")
  shippingPhone               String?                      @map("shipping_phone")
  shippingStreet              String?                      @map("shipping_street") @db.Text
  shippingWard                String?                      @map("shipping_ward")
  shippingProvince            String?                      @map("shipping_province")
  subtotal                    Float
  discountAmount              Float                        @default(0) @map("discount_amount")
  shippingFee                 Float                        @default(0) @map("shipping_fee")
  shippingDiscount            Float                        @default(0) @map("shipping_discount")
  totalAmount                 Float                        @map("total_amount")
  status                      OrderStatus                  @default(PENDING)
  paymentMethod               PaymentMethod?               @map("payment_method")
  paymentStatus               PaymentStatus                @default(UNPAID) @map("payment_status")
  paidAt                      DateTime?                    @map("paid_at")
  note                        String?                      @db.Text
  customerNote                String?                      @map("customer_note") @db.Text
  metadata                    Json?
  isRead                      Boolean                      @default(false) @map("is_read")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  commissions                 CommissionLedger[]
  items                       OrderItem[]
  appliedVouchers             OrderVoucher[]
  messageAudiences            MessageAudience[]
  messageAutomationExecutions MessageAutomationExecution[]
  messageLogs                 MessageLog[]
  user                        User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId                     String?                      @map("store_id")
  store                       Store?                       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  assigningSellerId           String?                      @map("assigning_seller_id")
  assigningSeller             User?                        @relation("OrderSeller", fields: [assigningSellerId], references: [id], onDelete: SetNull)
  assigningCareId             String?                      @map("assigning_care_id")
  assigningCare               User?                        @relation("OrderCare", fields: [assigningCareId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([storeId])
  @@index([assigningSellerId])
  @@index([assigningCareId])
  @@map("orders")
}

model OrderVoucher {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  userVoucherId   String      @map("user_voucher_id")
  discountApplied Float       @map("discount_applied")
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userVoucher     UserVoucher @relation(fields: [userVoucherId], references: [id])

  @@unique([orderId, userVoucherId])
  @@index([orderId])
  @@index([userVoucherId])
  @@map("order_vouchers")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  price     Float
  isGift    Boolean @default(false) @map("is_gift")
  size      String?
  color     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Voucher {
  id                 String           @id @default(uuid())
  code               String           @unique
  name               String
  description        String?          @db.Text
  campaignCategory   CampaignCategory @map("campaign_category")
  type               VoucherType
  value              Float
  minOrderValue      Float            @default(0) @map("min_order_value")
  maxDiscount        Float?           @map("max_discount")
  totalUsageLimit    Int?             @map("total_usage_limit")
  perCustomerLimit   Int              @default(1) @map("per_customer_limit")
  usedCount          Int              @default(0) @map("used_count")
  validFrom          DateTime?        @map("valid_from")
  validTo            DateTime?        @map("valid_to")
  durationDays       Int?             @map("duration_days")
  requiredCategoryId String?          @map("required_category_id")
  minProductCount    Int?             @map("min_product_count")
  isStackable        Boolean          @default(false) @map("is_stackable")
  stackTiers         Json?            @map("stack_tiers")
  isActive           Boolean          @default(true) @map("is_active")
  status             String           @default("AUTO")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  promotionRules     PromotionRule[]  @relation("CashbackVoucher")
  userVouchers       UserVoucher[]
  spinPrizes         SpinPrize[]      @relation("SpinVoucherTemplate")
  storeId            String?          @map("store_id")
  store              Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("vouchers")
}

model UserVoucher {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  voucherId       String         @map("voucher_id")
  isUsed          Boolean        @default(false) @map("is_used")
  usedAt          DateTime?      @map("used_at")
  expiresAt       DateTime?      @map("expires_at")
  sourceOrderCode String?        @unique @map("source_order_code")
  unlockAt        DateTime?      @map("unlock_at")
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  appliedOrders   OrderVoucher[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher         Voucher        @relation(fields: [voucherId], references: [id])

  @@index([userId, voucherId])
  @@index([userId, isUsed])
  @@index([voucherId], map: "user_vouchers_voucher_id_fkey")
  @@index([status, unlockAt])
  @@map("user_vouchers")
}

model PromotionRule {
  id                String        @id @default(uuid())
  name              String
  type              PromotionType
  isActive          Boolean       @default(true) @map("is_active")
  minOrderValue     Float?        @map("min_order_value")
  requiredProductId String?       @map("required_product_id")
  rewardVoucherId   String?       @map("reward_voucher_id")
  splitCount        Int?          @map("split_count")
  splitAmount       Float?        @map("split_amount")
  giftProductId     String?       @map("gift_product_id")
  giftQuantity      Int           @default(1) @map("gift_quantity")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  giftProduct       Product?      @relation("GiftProduct", fields: [giftProductId], references: [id])
  rewardVoucher     Voucher?      @relation("CashbackVoucher", fields: [rewardVoucherId], references: [id])

  @@index([giftProductId], map: "promotion_rules_gift_product_id_fkey")
  @@index([rewardVoucherId], map: "promotion_rules_reward_voucher_id_fkey")
  @@map("promotion_rules")
}

model CommissionLedger {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  orderId    String           @map("order_id")
  fromUserId String           @map("from_user_id")
  level      Int
  percentage Float
  amount     Float
  status     CommissionStatus @default(PENDING)
  reversedAt DateTime?        @map("reversed_at")
  createdAt  DateTime         @default(now())
  order      Order            @relation(fields: [orderId], references: [id])
  user       User             @relation("CommissionEarner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([status])
  @@map("commission_ledger")
}

model CommissionConfig {
  id         String   @id @default(uuid())
  level      Int      @unique
  percentage Float
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("commission_configs")
}

model RankConfig {
  id              String   @id @default(uuid())
  rank            Rank     @unique
  minTotalSpent   Float    @map("min_total_spent")
  minOrdersMonth  Int?     @map("min_orders_month")
  discountPercent Float?   @map("discount_percent")
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("rank_configs")
}

model SpinPrize {
  id            String         @id @default(uuid())
  name          String
  type          String
  value         Float?
  voucherId     String?        @map("voucher_id")
  condition     PrizeCondition @default(NO_CONDITION)
  giftProductId String?        @map("gift_product_id")
  probability   Float
  quantity      Int?
  wonCount      Int            @default(0) @map("won_count")
  imageUrl      String?        @map("image_url")
  color         String?
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  histories     SpinHistory[]
  giftProduct   Product?       @relation("SpinGiftProduct", fields: [giftProductId], references: [id])
  voucher       Voucher?       @relation("SpinVoucherTemplate", fields: [voucherId], references: [id])

  @@index([giftProductId], map: "spin_prizes_gift_product_id_fkey")
  @@index([voucherId])
  @@map("spin_prizes")
}

model SpinHistory {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  prizeId   String    @map("prize_id")
  won       Boolean   @default(false)
  createdAt DateTime  @default(now())
  prize     SpinPrize @relation(fields: [prizeId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([prizeId], map: "spin_histories_prize_id_fkey")
  @@map("spin_histories")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  channel   NotificationChannel
  type      String
  title     String
  body      String              @db.Text
  metadata  Json?
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?           @map("sent_at")
  error     String?             @db.Text
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, channel])
  @@map("notifications")
}

model NotificationTemplate {
  id             String              @id @default(uuid())
  channel        NotificationChannel
  type           String
  name           String
  subject        String?
  body           String              @db.Text
  zaloTemplateId String?             @map("zalo_template_id")
  zaloStatus     String?             @map("zalo_status")
  params         Json?
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([channel, type])
  @@map("notification_templates")
}

model MessageChannel {
  id              String                  @id @default(uuid())
  code            MessageChannelCode      @unique
  name            String
  description     String?                 @db.Text
  isActive        Boolean                 @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  templates       MessageTemplate[]
  campaigns       MessageCampaign[]
  logs            MessageLog[]
  audiences       MessageAudience[]
  schedules       MessageSchedule[]
  automationRules MessageAutomationRule[]
  providerConfigs MessageProviderConfig[]
  optOuts         MessageOptOut[]

  @@index([isActive])
  @@map("message_channels")
}

model MessageTemplate {
  id              String                  @id @default(uuid())
  channelId       String                  @map("channel_id")
  storeId         String?                 @map("store_id")
  createdById     String?                 @map("created_by_id")
  name            String
  kind            MessageTemplateKind     @default(CUSTOM)
  content         String                  @db.LongText
  variables       Json?
  metadata        Json?
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  channel         MessageChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store           Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation("MessageTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  campaigns       MessageCampaign[]
  logs            MessageLog[]
  automationRules MessageAutomationRule[]

  @@index([channelId, isActive])
  @@index([storeId])
  @@index([createdById])
  @@map("message_templates")
}

model MessageCampaign {
  id               String                 @id @default(uuid())
  channelId        String                 @map("channel_id")
  storeId          String?                @map("store_id")
  templateId       String?                @map("template_id")
  providerConfigId String?                @map("provider_config_id")
  automationRuleId String?                @map("automation_rule_id")
  createdById      String?                @map("created_by_id")
  name             String
  audienceSource   MessageAudienceSource  @default(MANUAL) @map("audience_source")
  sendMode         MessageSendMode        @default(IMMEDIATE) @map("send_mode")
  purpose          MessagePurpose         @default(MARKETING)
  status           MessageCampaignStatus  @default(DRAFT)
  filters          Json?
  messageContent   String?                @map("message_content") @db.LongText
  scheduledAt      DateTime?              @map("scheduled_at")
  sentAt           DateTime?              @map("sent_at")
  completedAt      DateTime?              @map("completed_at")
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  channel          MessageChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store            Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)
  template         MessageTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  providerConfig   MessageProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  automationRule   MessageAutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  createdBy        User?                  @relation("MessageCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  audiences        MessageAudience[]
  logs             MessageLog[]
  schedules        MessageSchedule[]

  @@index([channelId, status])
  @@index([purpose])
  @@index([storeId])
  @@index([templateId])
  @@index([providerConfigId])
  @@index([automationRuleId])
  @@index([createdById])
  @@index([scheduledAt])
  @@map("message_campaigns")
}

model MessageAudience {
  id                String                   @id @default(uuid())
  campaignId        String                   @map("campaign_id")
  channelId         String                   @map("channel_id")
  storeId           String?                  @map("store_id")
  userId            String?                  @map("user_id")
  orderId           String?                  @map("order_id")
  contactIdentityId String?                  @map("contact_identity_id")
  recipientName     String?                  @map("recipient_name")
  recipientValue    String                   @map("recipient_value")
  snapshotData      Json?                    @map("snapshot_data")
  status            MessageAudienceStatus    @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  campaign          MessageCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel           MessageChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store             Store?                   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contactIdentity   CustomerContactIdentity? @relation(fields: [contactIdentityId], references: [id], onDelete: SetNull)
  logs              MessageLog[]

  @@index([campaignId])
  @@index([campaignId, recipientValue])
  @@index([channelId, status])
  @@index([storeId])
  @@index([userId])
  @@index([orderId])
  @@index([contactIdentityId])
  @@index([recipientValue])
  @@map("message_audiences")
}

model MessageSchedule {
  id               String                 @id @default(uuid())
  channelId        String                 @map("channel_id")
  storeId          String?                @map("store_id")
  campaignId       String?                @map("campaign_id")
  automationRuleId String?                @map("automation_rule_id")
  providerConfigId String?                @map("provider_config_id")
  createdById      String?                @map("created_by_id")
  runAt            DateTime               @map("run_at")
  status           MessageScheduleStatus  @default(PENDING)
  payload          Json?
  attemptCount     Int                    @default(0) @map("attempt_count")
  lastAttemptAt    DateTime?              @map("last_attempt_at")
  lastError        String?                @map("last_error") @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  channel          MessageChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store            Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)
  campaign         MessageCampaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  automationRule   MessageAutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  providerConfig   MessageProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  createdBy        User?                  @relation("MessageScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([channelId, status, runAt])
  @@index([storeId])
  @@index([campaignId])
  @@index([automationRuleId])
  @@index([providerConfigId])
  @@index([createdById])
  @@map("message_schedules")
}

model MessageAutomationRule {
  id               String                       @id @default(uuid())
  channelId        String                       @map("channel_id")
  storeId          String?                      @map("store_id")
  templateId       String?                      @map("template_id")
  providerConfigId String?                      @map("provider_config_id")
  createdById      String?                      @map("created_by_id")
  name             String
  triggerType      MessageAutomationTriggerType @map("trigger_type")
  triggerConfig    Json?                        @map("trigger_config")
  audienceFilter   Json?                        @map("audience_filter")
  metadata         Json?
  isActive         Boolean                      @default(true) @map("is_active")
  lastRunAt        DateTime?                    @map("last_run_at")
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  channel          MessageChannel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store            Store?                       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  template         MessageTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  providerConfig   MessageProviderConfig?       @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  createdBy        User?                        @relation("MessageAutomationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  campaigns        MessageCampaign[]
  executions       MessageAutomationExecution[]
  logs             MessageLog[]
  schedules        MessageSchedule[]

  @@index([channelId, triggerType, isActive])
  @@index([storeId])
  @@index([templateId])
  @@index([providerConfigId])
  @@index([createdById])
  @@map("automation_rules")
}

model CustomerContactIdentity {
  id         String                      @id @default(uuid())
  userId     String                      @map("user_id")
  type       CustomerContactIdentityType
  value      String
  label      String?
  isPrimary  Boolean                     @default(false) @map("is_primary")
  isVerified Boolean                     @default(false) @map("is_verified")
  metadata   Json?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  audiences  MessageAudience[]
  optOuts    MessageOptOut[]

  @@unique([type, value])
  @@index([userId, type])
  @@index([value])
  @@map("customer_contact_identities")
}

model MessageProviderConfig {
  id              String                  @id @default(uuid())
  channelId       String                  @map("channel_id")
  storeId         String?                 @map("store_id")
  name            String
  providerKey     String                  @map("provider_key")
  settings        Json?
  secretSettings  Json?                   @map("secret_settings")
  metadata        Json?
  isActive        Boolean                 @default(true) @map("is_active")
  isDefault       Boolean                 @default(false) @map("is_default")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  channel         MessageChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store           Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  campaigns       MessageCampaign[]
  logs            MessageLog[]
  schedules       MessageSchedule[]
  automationRules MessageAutomationRule[]

  @@index([channelId, isActive])
  @@index([storeId])
  @@index([providerKey])
  @@map("message_provider_configs")
}

model MessageOptOut {
  id                String                   @id @default(uuid())
  channelId         String                   @map("channel_id")
  userId            String?                  @map("user_id")
  contactIdentityId String?                  @map("contact_identity_id")
  recipientValue    String                   @map("recipient_value")
  reason            String?                  @db.Text
  source            String?
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  channel           MessageChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactIdentity   CustomerContactIdentity? @relation(fields: [contactIdentityId], references: [id], onDelete: SetNull)

  @@unique([channelId, recipientValue])
  @@index([userId])
  @@index([contactIdentityId])
  @@index([isActive])
  @@map("message_opt_outs")
}

model MessageAuditLog {
  id         String   @id @default(uuid())
  storeId    String?  @map("store_id")
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("message_audit_logs")
}

model MessageLog {
  id                   String                       @id @default(uuid())
  idempotencyKey       String?                      @unique @map("idempotency_key")
  channelId            String                       @map("channel_id")
  storeId              String?                      @map("store_id")
  campaignId           String?                      @map("campaign_id")
  templateId           String?                      @map("template_id")
  automationRuleId     String?                      @map("automation_rule_id")
  providerConfigId     String?                      @map("provider_config_id")
  audienceId           String?                      @map("audience_id")
  userId               String?                      @map("user_id")
  orderId              String?                      @map("order_id")
  createdById          String?                      @map("created_by_id")
  recipientName        String?                      @map("recipient_name")
  recipientValue       String                       @map("recipient_value")
  purpose              MessagePurpose               @default(TRANSACTIONAL)
  content              String                       @db.LongText
  renderedVariables    Json?                        @map("rendered_variables")
  status               MessageLogStatus             @default(QUEUED)
  providerMessageId    String?                      @map("provider_message_id")
  errorCode            String?                      @map("error_code")
  errorMessage         String?                      @map("error_message") @db.Text
  queuedAt             DateTime?                    @map("queued_at")
  sentAt               DateTime?                    @map("sent_at")
  deliveredAt          DateTime?                    @map("delivered_at")
  readAt               DateTime?                    @map("read_at")
  metadata             Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  channel              MessageChannel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store                Store?                       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  campaign             MessageCampaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template             MessageTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  automationRule       MessageAutomationRule?       @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  providerConfig       MessageProviderConfig?       @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  audience             MessageAudience?             @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  automationExecutions MessageAutomationExecution[]
  user                 User?                        @relation("MessageLogRecipient", fields: [userId], references: [id], onDelete: SetNull)
  order                Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy            User?                        @relation("MessageLogCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([idempotencyKey])
  @@index([channelId, status])
  @@index([storeId])
  @@index([campaignId])
  @@index([templateId])
  @@index([automationRuleId])
  @@index([providerConfigId])
  @@index([audienceId])
  @@index([userId])
  @@index([orderId])
  @@index([createdById])
  @@index([recipientValue])
  @@index([channelId, recipientValue, purpose, createdAt], map: "msg_logs_recipient_purpose_created_idx")
  @@index([channelId, recipientValue, purpose, status, createdAt], map: "msg_logs_recipient_purpose_status_created_idx")
  @@index([sentAt])
  @@map("message_logs")
}

model MessageAutomationExecution {
  id               String                           @id @default(uuid())
  automationRuleId String                           @map("automation_rule_id")
  messageLogId     String?                          @unique @map("message_log_id")
  storeId          String?                          @map("store_id")
  userId           String?                          @map("user_id")
  orderId          String?                          @map("order_id")
  triggerType      MessageAutomationTriggerType     @map("trigger_type")
  triggerKey       String                           @map("trigger_key")
  status           MessageAutomationExecutionStatus @default(PENDING)
  reason           String?                          @db.Text
  payload          Json?
  executedAt       DateTime?                        @map("executed_at")
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  automationRule   MessageAutomationRule            @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  messageLog       MessageLog?                      @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  store            Store?                           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user             User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  order            Order?                           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([automationRuleId, triggerKey])
  @@index([messageLogId])
  @@index([storeId])
  @@index([userId])
  @@index([orderId])
  @@index([triggerType, status])
  @@map("message_automation_executions")
}

