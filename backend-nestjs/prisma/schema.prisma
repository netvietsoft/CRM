model MessageLog {
  id                   String                       @id @default(uuid())
  idempotencyKey       String?                      @unique @map("idempotency_key")
  channelId            String                       @map("channel_id")
  storeId              String?                      @map("store_id")
  campaignId           String?                      @map("campaign_id")
  templateId           String?                      @map("template_id")
  automationRuleId     String?                      @map("automation_rule_id")
  providerConfigId     String?                      @map("provider_config_id")
  audienceId           String?                      @map("audience_id")
  userId               String?                      @map("user_id")
  orderId              String?                      @map("order_id")
  createdById          String?                      @map("created_by_id")
  recipientName        String?                      @map("recipient_name")
  recipientValue       String                       @map("recipient_value")
  purpose              MessagePurpose               @default(TRANSACTIONAL)
  content              String                       @db.LongText
  renderedVariables    Json?                        @map("rendered_variables")
  status               MessageLogStatus             @default(QUEUED)
  providerMessageId    String?                      @map("provider_message_id")
  errorCode            String?                      @map("error_code")
  errorMessage         String?                      @map("error_message") @db.Text
  queuedAt             DateTime?                    @map("queued_at")
  sentAt               DateTime?                    @map("sent_at")
  deliveredAt          DateTime?                    @map("delivered_at")
  readAt               DateTime?                    @map("read_at")
  metadata             Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  channel              MessageChannel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  store                Store?                       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  campaign             MessageCampaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template             MessageTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  automationRule       MessageAutomationRule?       @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  providerConfig       MessageProviderConfig?       @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  audience             MessageAudience?             @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  automationExecutions MessageAutomationExecution[]
  user                 User?                        @relation("MessageLogRecipient", fields: [userId], references: [id], onDelete: SetNull)
  order                Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy            User?                        @relation("MessageLogCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([idempotencyKey])
  @@index([channelId, status])
  @@index([storeId])
  @@index([campaignId])
  @@index([templateId])
  @@index([automationRuleId])
  @@index([providerConfigId])
  @@index([audienceId])
  @@index([userId])
  @@index([orderId])
  @@index([createdById])
  @@index([recipientValue])
  @@index([channelId, recipientValue, purpose, createdAt], map: "msg_logs_recipient_purpose_created_idx")
  @@index([channelId, recipientValue, purpose, status, createdAt], map: "msg_logs_recipient_purpose_status_created_idx")
  @@index([sentAt])
  @@map("message_logs")
}

model MessageAutomationExecution {
  id               String                           @id @default(uuid())
  automationRuleId String                           @map("automation_rule_id")
  messageLogId     String?                          @unique @map("message_log_id")
  storeId          String?                          @map("store_id")
  userId           String?                          @map("user_id")
  orderId          String?                          @map("order_id")
  triggerType      MessageAutomationTriggerType     @map("trigger_type")
  triggerKey       String                           @map("trigger_key")
  status           MessageAutomationExecutionStatus @default(PENDING)
  reason           String?                          @db.Text
  payload          Json?
  executedAt       DateTime?                        @map("executed_at")
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  automationRule   MessageAutomationRule            @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  messageLog       MessageLog?                      @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  store            Store?                           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user             User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  order            Order?                           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([automationRuleId, triggerKey])
  @@index([messageLogId])
  @@index([storeId])
  @@index([userId])
  @@index([orderId])
  @@index([triggerType, status])
  @@map("message_automation_executions")
}

