  @@index([purpose])
  @@index([storeId])
  @@index([templateId])
  @@index([providerConfigId])
  @@index([automationRuleId])
  @@index([createdById])
  @@index([scheduledAt])
  @@map("message_campaigns")
}

model MessageAudience {
  id                String                   @id @default(uuid())
  campaignId        String                   @map("campaign_id")
  channelId         String                   @map("channel_id")
