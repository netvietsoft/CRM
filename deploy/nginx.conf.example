# ============================================================================
# CRM netvietsoft — Nginx reverse proxy (3 domain)
# Copy vào /etc/nginx/sites-available/crm.conf → ln -s sang sites-enabled → nginx -t → systemctl reload nginx
# TLS: chạy `certbot --nginx -d lestgoai.com -d admin.lestgoai.com -d api.lestgoai.com`
#      (certbot tự chèn block 443 + redirect 80→443).
# ============================================================================

# --- Backend API: api.lestgoai.com → 8070 ---
server {
    listen 80;
    server_name api.lestgoai.com;
    client_max_body_size 25m;                 # upload ảnh/đơn

    location / {
        proxy_pass http://127.0.0.1:8070;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;      # socket.io (WebSocket)
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

# --- Frontend khách: lestgoai.com → 3069 ---
server {
    listen 80;
    server_name lestgoai.com www.lestgoai.com;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3069;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Admin: admin.lestgoai.com → 3070 ---
server {
    listen 80;
    server_name admin.lestgoai.com;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3070;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
